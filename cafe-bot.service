[Unit]
Description=Telegram-бот кафе
After=network.target

[Service]
Type=simple
# Змініть шлях та користувача на свої
User=botuser
WorkingDirectory=/home/botuser/cafe_bot
ExecStart=/home/botuser/cafe_bot/venv/bin/python /home/botuser/cafe_bot/bot.py
Restart=always
RestartSec=5
Environment=DATA_DIR=/home/botuser/cafe_bot/data

[Install]
WantedBy=multi-user.target
